"><filename>%1</filename>"

#: src/ExportManager.cpp:499
#, kde-format
msgid "Cannot save screenshot. Error while opening file."
msgstr "Nedá sa uložiť snímka obrazovky. Chyba pri otváraní súboru."

#: src/ExportManager.cpp:503
#, kde-format
msgid "Cannot save screenshot. Error while writing file."
msgstr "Nedá sa uložiť snímka obrazovky. Vyskytla sa chyba pri zápise súboru."

#: src/ExportManager.cpp:544
#, kde-format
msgid "Cannot save screenshot. Error while writing temporary local file."
msgstr ""
"Nedá sa uložiť snímka obrazovky. Vyskytla sa chyba pri zápise dočasného "
"miestneho súboru."

#: src/ExportManager.cpp:551
#, kde-format
msgid "Cannot save screenshot. The save filename is invalid."
msgstr "Nedá sa uložiť snímka obrazovky. Ukladaný názov súboru nie je platný."

#: src/ExportManager.cpp:556
#, kde-format
msgid "Cannot save screenshot. Saving to remote locations is not supported."
msgstr ""
"Snímku nie je možné uložiť. Ukladanie do vzdialených umiestnení nie je "
"podporované."

#: src/ExportManager.cpp:641
#, kde-format
