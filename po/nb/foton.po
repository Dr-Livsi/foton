#, kde-format
msgid "Take a screenshot and exit without showing the GUI"
msgstr "Ta skjermbildet og avslutt uten å vise det grafiske grensesnittet"

#: src/CommandLineOptions.h:56
#, kde-format
msgid ""
"Start in the background with an icon in the system tray and wait for global "
"shortcuts"
msgstr ""
"Start i bakgrunnen med et ikon i systemkurven og vent på globale snarveier"

