#, kde-format
msgctxt "@action in capture mode section"
msgid "Current Screen"
msgstr "Текущ екран"

#: src/CaptureModeModel.cpp:163
#, kde-format
msgctxt "@action in capture mode section"
msgid "Active Window"
msgstr "Активен прозорец"

#: src/CaptureModeModel.cpp:165
#, kde-format
msgctxt "@action in capture mode section"
msgid "Window Under Cursor"
msgstr "Прозорец под курсор"

#: src/CaptureModeModel.cpp:167
#, kde-format
msgctxt "@action in capture mode section"
msgid "All Screens"
msgstr "Всички екрани"

