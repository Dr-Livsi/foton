#: src/CommandLineOptions.h:22
#, kde-format
msgid "Capture the entire desktop (default)"
msgstr "Capturar todo el escritorio (predeterminado)"

#: src/CommandLineOptions.h:26
#, kde-format
msgid ""
"When used with -f/--fullscreen, capture all screens scaled to the same size"
msgstr ""
"Cuando se usa con -f/--fullscreen, capturar todas las pantallas escaladas al "
"mismo tamaño"

#: src/CommandLineOptions.h:30
#, kde-format
msgid "Capture the current monitor"
msgstr "Capturar el monitor actual"

#: src/CommandLineOptions.h:34
#, kde-format
msgid "Capture the active window"
msgstr "Capturar la ventana activa"

#: src/CommandLineOptions.h:37
#, kde-format
msgid ""
"Capture the window currently under the cursor, including parents of pop-up "
"menus"
msgstr ""
"Capturar la ventana que está bajo el cursor, incluyendo las ventanas a las "
"que pertenecen los menús emergentes"

#: src/CommandLineOptions.h:40
#, kde-format
msgid "Capture a rectangular region of the screen"
msgstr "Capturar una región rectangular de la pantalla"

#: src/CommandLineOptions.h:44
#, kde-format
msgid "Launch Foton without taking a screenshot"
msgstr "Iniciar Foton sin hacer una captura de pantalla"

#: src/CommandLineOptions.h:48
#, kde-format
msgid "Start in GUI mode (default)"
msgstr "Iniciar en modo de interfaz gráfica (predeterminado)"

#: src/CommandLineOptions.h:52
#, kde-format
msgid "Take a screenshot and exit without showing the GUI"
msgstr "Hacer una captura de pantalla y salir sin mostrar la interfaz gráfica"

#: src/CommandLineOptions.h:56
#, kde-format
msgid ""
"Start in the background with an icon in the system tray and wait for global "
"shortcuts"
msgstr ""
"Iniciar en segundo plano con un icono en la bandeja del sistema y esperar "
"los accesos rápidos globales"

#: src/CommandLineOptions.h:60
#, kde-format
msgid ""
"In background mode, do not pop up a notification when the screenshot is taken"
msgstr ""
"En el modo de segundo plano, no mostrar una notificación emergente al hacer "
"una captura de pantalla"

#: src/CommandLineOptions.h:64
#, kde-format
msgid "In background mode, save image to specified file"
msgstr "En el modo de segundo plano, guardar la imagen en el archivo indicado"

#: src/CommandLineOptions.h:69
#, kde-format
msgid "In background mode, delay before taking the shot (in milliseconds)"
msgstr ""
"En el modo de segundo plano, demora antes de hacer la captura (en "
"milisegundos)"

#: src/CommandLineOptions.h:74
#, kde-format
msgid ""
"In background mode, copy screenshot image to clipboard, unless -o is also "
"used."
msgstr ""
"En el modo de segundo plano, copiar la imagen de la captura de pantalla en "
"el portapapeles, excepto si también se ha usado -o."

#: src/CommandLineOptions.h:78
#, kde-format
msgid "In background mode, copy screenshot file path to clipboard"
msgstr ""
"En el modo de segundo plano, copiar la ruta del archivo de la captura de "
"pantalla en el portapapeles"

#: src/CommandLineOptions.h:82
#, kde-format
msgid ""
"Starts a new GUI instance of Foton instead of passing the arguments to an "
"already running instance"
msgstr ""
"Inicia una nueva instancia gráfica de Foton en lugar de pasar los argumentos "
"a una instancia que ya está en ejecución"

#: src/CommandLineOptions.h:86
#, kde-format
msgid "In background mode, include pointer in the screenshot"
msgstr ""
"En el modo de segundo plano, incluir el puntero en la captura de pantalla"

#: src/CommandLineOptions.h:90
#, kde-format
msgid "In background mode, exclude decorations in the screenshot"
msgstr ""
"En el modo de segundo plano, excluir las decoraciones en la captura de "
"pantalla"

#: src/CommandLineOptions.h:92
#, kde-format
msgid "In background mode, exclude shadows in the screenshot"
msgstr ""
"En el modo de segundo plano, excluir las sombras en la captura de pantalla"

#: src/CommandLineOptions.h:95
#, kde-format
msgid "Open and edit existing screenshot file"
msgstr "Abrir y editar un archivo de captura de pantalla existente"

