#: src/CommandLineOptions.h:22
#, kde-format
msgid "Capture the entire desktop (default)"
msgstr "Сделать снимок всего рабочего стола (по умолчанию)."

#: src/CommandLineOptions.h:26
#, kde-format
msgid ""
"When used with -f/--fullscreen, capture all screens scaled to the same size"
msgstr ""
"При использовании с параметром -f/--fullscreen захватываются все экраны, "
"масштабированные до одного размера."

# BUGME: term inconsistency: "monitor" vs "screen" --aspotashev
#: src/CommandLineOptions.h:30
#, kde-format
msgid "Capture the current monitor"
msgstr "Сделать снимок текущего экрана."

#: src/CommandLineOptions.h:34
#, kde-format
msgid "Capture the active window"
msgstr "Сделать снимок активного окна."

#: src/CommandLineOptions.h:37
#, kde-format
msgid ""
"Capture the window currently under the cursor, including parents of pop-up "
"menus"
msgstr ""
"Сделать снимок окна под указателем мыши, включая родительские окна "
"всплывающих меню."

#: src/CommandLineOptions.h:40
#, kde-format
msgid "Capture a rectangular region of the screen"
msgstr "Сделать снимок прямоугольной области экрана."

#: src/CommandLineOptions.h:44
#, kde-format
msgid "Launch Foton without taking a screenshot"
msgstr "Запустить Foton без создания снимка экрана"

#: src/CommandLineOptions.h:48
#, kde-format
msgid "Start in GUI mode (default)"
msgstr "Запустить в графическом режиме (по умолчанию)."

#: src/CommandLineOptions.h:52
#, kde-format
msgid "Take a screenshot and exit without showing the GUI"
msgstr ""
"Фоновый режим: сделать снимок экрана и выйти, не показывая графический "
"интерфейс."

#: src/CommandLineOptions.h:56
#, kde-format
msgid ""
"Start in the background with an icon in the system tray and wait for global "
"shortcuts"
msgstr ""
"Запуститься в фоне со значком в системном лотке и ожидать глобальные "
"комбинации клавиш"

#: src/CommandLineOptions.h:60
#, kde-format
msgid ""
"In background mode, do not pop up a notification when the screenshot is taken"
msgstr ""
"В фоновом режиме не показывать всплывающее уведомление после создания снимка "
"экрана."

#: src/CommandLineOptions.h:64
#, kde-format
msgid "In background mode, save image to specified file"
msgstr "В фоновом режиме сохранить изображение в указанный файл."

#: src/CommandLineOptions.h:69
#, kde-format
msgid "In background mode, delay before taking the shot (in milliseconds)"
msgstr "В фоновом режиме сделать задержку перед съёмкой (в миллисекундах)."

#: src/CommandLineOptions.h:74
#, kde-format
msgid ""
"In background mode, copy screenshot image to clipboard, unless -o is also "
"used."
msgstr ""
"В фоновом режиме скопировать изображение в буфер обмена (только если не "
"использован аргумент -o)."

#: src/CommandLineOptions.h:78
#, kde-format
msgid "In background mode, copy screenshot file path to clipboard"
msgstr "В фоновом режиме скопировать путь к файлу изображения в буфер обмена."

#: src/CommandLineOptions.h:82
#, kde-format
msgid ""
"Starts a new GUI instance of Foton instead of passing the arguments to an "
"already running instance"
msgstr ""
"Запустить новый экземпляр Foton с интерфейсом вместо передачи параметров уже "
"запущенному экземпляру"

#: src/CommandLineOptions.h:86
#, kde-format
msgid "In background mode, include pointer in the screenshot"
msgstr "В фоновом режиме включать указатель мыши в снимок экрана."

#: src/CommandLineOptions.h:90
#, kde-format
msgid "In background mode, exclude decorations in the screenshot"
msgstr "В фоновом режиме не включать заголовок и границы окна в снимок."

#: src/CommandLineOptions.h:92
#, kde-format
msgid "In background mode, exclude shadows in the screenshot"
msgstr "В фоновом режиме не включать тень окна в снимок."

#: src/CommandLineOptions.h:95
#, kde-format
msgid "Open and edit existing screenshot file"
msgstr "Открыть и отредактировать существующий файл снимка экрана"

#: src/CommandLineOptions.h:98
#, kde-format
msgid "Accept region selection on click-and-release"
msgstr "Выделять область при отпускании кнопки мыши"

#: src/ExportManager.cpp:474
#, kde-format
msgctxt "%1 is an error message"
msgid "QImageWriter cannot write image: %1"
msgstr "Ошибка записи изображения с помощью QImageWriter: %1"

#: src/ExportManager.cpp:490
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Cannot save screenshot because creating the directory failed:<nl/"
"><filename>%1</filename>"
msgstr ""
"Не удалось сохранить снимок экрана из-за ошибки создания папки:<nl/"
"><filename>%1</filename>"

#: src/ExportManager.cpp:499
#, kde-format
msgid "Cannot save screenshot. Error while opening file."
msgstr "Не удалось сохранить снимок экрана. Ошибка при открытии файла."

#: src/ExportManager.cpp:503
#, kde-format
msgid "Cannot save screenshot. Error while writing file."
msgstr "Не удалось сохранить снимок экрана. Ошибка при записи файла."

#: src/ExportManager.cpp:544
#, kde-format
msgid "Cannot save screenshot. Error while writing temporary local file."
msgstr ""
"Не удалось сохранить снимок экрана. Ошибка при записи временного файла."

#: src/ExportManager.cpp:551
