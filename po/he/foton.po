#: src/CommandLineOptions.h:22
#, kde-format
msgid "Capture the entire desktop (default)"
msgstr "צילום כל המסך (ברירת־מחדל)"

#: src/CommandLineOptions.h:26
#, kde-format
msgid ""
"When used with -f/--fullscreen, capture all screens scaled to the same size"
msgstr ""
"בעת שימוש עם ‎-f/--fullscreen, ללכוד את כל המסכים בתיאום קנה מידה לאותו הגודל"

#: src/CommandLineOptions.h:30
#, kde-format
msgid "Capture the current monitor"
msgstr "צילום המסך הנוכחי"

#: src/CommandLineOptions.h:34
#, kde-format
msgid "Capture the active window"
msgstr "צילום החלון הפעיל"

#: src/CommandLineOptions.h:37
#, kde-format
msgid ""
"Capture the window currently under the cursor, including parents of pop-up "
"menus"
msgstr "צילום החלון הנוכחי שמתחת לעכבר, כולל הורים של תפריטים קופצים"

#: src/CommandLineOptions.h:40
#, kde-format
msgid "Capture a rectangular region of the screen"
msgstr "צילום אזור מרובע מהמסך"

#: src/CommandLineOptions.h:44
#, kde-format
msgid "Launch Foton without taking a screenshot"
msgstr "להפעיל את Foton מבלי לצלם"

#: src/CommandLineOptions.h:48
#, kde-format
msgid "Start in GUI mode (default)"
msgstr "הפעלה במצב ממשק חזותי (ברירת־מחדל)"

#: src/CommandLineOptions.h:52
#, kde-format
msgid "Take a screenshot and exit without showing the GUI"
msgstr "לצלם את המסך ולצאת מבלי להציג את החלון החזותי"

#: src/CommandLineOptions.h:56
#, kde-format
msgid ""
"Start in the background with an icon in the system tray and wait for global "
"shortcuts"
msgstr "להפעיל ברקע עם סמל במגש המערכת ולהמתין לקיצורי מקשים גלובליים"

#: src/CommandLineOptions.h:60
#, kde-format
msgid ""
"In background mode, do not pop up a notification when the screenshot is taken"
msgstr "במצב רקע, לא להקפיץ התראה כשהמסך מצולם"

#: src/CommandLineOptions.h:64
#, kde-format
msgid "In background mode, save image to specified file"
msgstr "במצב רקע, לשמור את התמונה לקובץ מסוים"

#: src/CommandLineOptions.h:69
#, kde-format
msgid "In background mode, delay before taking the shot (in milliseconds)"
msgstr "במצב רקע, להשהות בטרם הצילום (במילישניות)"

#: src/CommandLineOptions.h:74
#, kde-format
msgid ""
"In background mode, copy screenshot image to clipboard, unless -o is also "
"used."
msgstr ""
"במצב רקע, להעתיק את תמונת צילום המסך ללוח הגזירים, אלא אם כן נעשה שימוש גם "
"ב־‎-o."

#: src/CommandLineOptions.h:78
#, kde-format
msgid "In background mode, copy screenshot file path to clipboard"
msgstr "במצב רקע, להעתיק את נתיב קובץ צילום המסך ללוח הגזירים"

#: src/CommandLineOptions.h:82
#, kde-format
msgid ""
"Starts a new GUI instance of Foton instead of passing the arguments to an "
"already running instance"
msgstr ""
"מפעיל עותק חדש של Foton עם ממשק במקום להעביר את הארגומנטים לעותק שכבר פועל"

#: src/CommandLineOptions.h:86
#, kde-format
msgid "In background mode, include pointer in the screenshot"
msgstr "במצב רקע, לכלול את סמן העכבר בצילום המסך"

#: src/CommandLineOptions.h:90
#, kde-format
msgid "In background mode, exclude decorations in the screenshot"
msgstr "במצב רקע, לא לכלול את העיטורים בצילום המסך"

#: src/CommandLineOptions.h:92
#, kde-format
msgid "In background mode, exclude shadows in the screenshot"
msgstr "במצב רקע, לא לכלול את ההצללות בצילום המסך"

#: src/CommandLineOptions.h:95
#, kde-format
msgid "Open and edit existing screenshot file"
msgstr "פתיחת קובץ צילום מסך קיים"

#: src/CommandLineOptions.h:98
#, kde-format
msgid "Accept region selection on click-and-release"
msgstr "לקבל בחירת אזור בלחיצה ושחרור"

