"אי אפשר לשמור את צילום המסך כי יצירת התיקייה נכשלה:<nl/><filename>%1</"
"filename>"

#: src/ExportManager.cpp:499
#, kde-format
msgid "Cannot save screenshot. Error while opening file."
msgstr "לא ניתן לשמור צילום מסך. שגיאה בפתיחת הקובץ."

#: src/ExportManager.cpp:503
#, kde-format
msgid "Cannot save screenshot. Error while writing file."
msgstr "לא ניתן לשמור צילום מסך. שגיאה בכתיבה."

#: src/ExportManager.cpp:544
