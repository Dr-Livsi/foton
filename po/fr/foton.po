#: src/CommandLineOptions.h:22
#, kde-format
msgid "Capture the entire desktop (default)"
msgstr "Capturer le bureau entier (par défaut)"

#: src/CommandLineOptions.h:26
#, kde-format
msgid ""
"When used with -f/--fullscreen, capture all screens scaled to the same size"
msgstr ""
"Lorsque utilisé avec l'option « -f/ --fullscreen », permet la capture de "
"tous les écrans mis à l'échelle selon la même taille"

#: src/CommandLineOptions.h:30
#, kde-format
msgid "Capture the current monitor"
msgstr "Capturer le moniteur actuel"

#: src/CommandLineOptions.h:34
#, kde-format
msgid "Capture the active window"
msgstr "Capturer la fenêtre active"

#: src/CommandLineOptions.h:37
#, kde-format
msgid ""
"Capture the window currently under the cursor, including parents of pop-up "
"menus"
msgstr ""
"Capturer la fenêtre actuellement sous le curseur, en incluant les fenêtres "
"parentes des menus contextuels."

#: src/CommandLineOptions.h:40
#, kde-format
msgid "Capture a rectangular region of the screen"
msgstr "Capturer une région rectangulaire de l'écran"

#: src/CommandLineOptions.h:44
#, kde-format
msgid "Launch Foton without taking a screenshot"
msgstr "Lancer Foton sans réaliser de capture d'écran"

#: src/CommandLineOptions.h:48
#, kde-format
msgid "Start in GUI mode (default)"
msgstr "Démarrer en mode interface graphique (par défaut)"

#: src/CommandLineOptions.h:52
#, kde-format
msgid "Take a screenshot and exit without showing the GUI"
msgstr "Effectuer une capture d'écran et quitter sans afficher l'interface"

#: src/CommandLineOptions.h:56
#, kde-format
msgid ""
"Start in the background with an icon in the system tray and wait for global "
"shortcuts"
msgstr ""
"Démarrer en arrière-plan avec une icône dans la zone de notification et "
"attendre les raccourcis globaux"

#: src/CommandLineOptions.h:60
#, kde-format
msgid ""
"In background mode, do not pop up a notification when the screenshot is taken"
msgstr ""
"En mode arrière-plan, ne pas afficher de notification lorsqu'une capture "
"d'écran est effectuée"

#: src/CommandLineOptions.h:64
#, kde-format
msgid "In background mode, save image to specified file"
msgstr "En mode arrière-plan, enregistrer l'image dans le fichier spécifié"

#: src/CommandLineOptions.h:69
#, kde-format
msgid "In background mode, delay before taking the shot (in milliseconds)"
msgstr ""
"En mode arrière-plan, délai avant de prendre la capture (En millisecondes)"

#: src/CommandLineOptions.h:74
#, kde-format
msgid ""
"In background mode, copy screenshot image to clipboard, unless -o is also "
"used."
msgstr ""
"En mode arrière-plan, copier la capture d'écran dans le presse-papier, sauf "
"si le paramètre « -o » est aussi utilisé."

#: src/CommandLineOptions.h:78
#, kde-format
msgid "In background mode, copy screenshot file path to clipboard"
msgstr "En mode arrière-plan, copier la capture d'écran dans le presse-papier"

#: src/CommandLineOptions.h:82
#, kde-format
msgid ""
"Starts a new GUI instance of Foton instead of passing the arguments to an "
"already running instance"
msgstr ""
"Démarre une nouvelle instance graphique de Foton au lieu de transmettre les "
"arguments à une instance déjà en cours d'exécution"

#: src/CommandLineOptions.h:86
#, kde-format
msgid "In background mode, include pointer in the screenshot"
msgstr ""
"En mode d'arrière-plan, inclure le pointeur de souris dans la capture d'écran"

#: src/CommandLineOptions.h:90
#, kde-format
msgid "In background mode, exclude decorations in the screenshot"
msgstr ""
"En mode d'arrière-plan, exclure les décorations de fenêtres dans la capture "
"d'écran"

#: src/CommandLineOptions.h:92
#, kde-format
msgid "In background mode, exclude shadows in the screenshot"
msgstr ""
"En mode d'arrière-plan, exclure les ombrages de fenêtres de la capture "
"d'écran"

#: src/CommandLineOptions.h:95
#, kde-format
msgid "Open and edit existing screenshot file"
msgstr "Ouvrir ou modifier un fichier existant de capture d'écran"

#: src/CommandLineOptions.h:98
#, kde-format
msgid "Accept region selection on click-and-release"
msgstr "Accepter la sélection d'une zone sur un cliquer-relâcher"

