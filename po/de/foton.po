#: src/CommandLineOptions.h:22
#, kde-format
msgid "Capture the entire desktop (default)"
msgstr "Schnappschuss der gesamten Arbeitsfläche (Voreinstellung)"

#: src/CommandLineOptions.h:26
#, kde-format
msgid ""
"When used with -f/--fullscreen, capture all screens scaled to the same size"
msgstr ""
"Bei Verwendung mit -f/--fullscreen werden alle Bildschirme beim Erstellen "
"eines Schnappschusses auf dieselbe Größe skaliert"

#: src/CommandLineOptions.h:30
#, kde-format
msgid "Capture the current monitor"
msgstr "Schnappschuss des aktuellen Bildschirms"

#: src/CommandLineOptions.h:34
#, kde-format
msgid "Capture the active window"
msgstr "Schnappschuss des aktiven Fensters"

#: src/CommandLineOptions.h:37
#, kde-format
msgid ""
"Capture the window currently under the cursor, including parents of pop-up "
"menus"
msgstr ""
"Schnappschuss des Fensters unter dem Mauszeiger inklusive der "
"Aufklappelemente (Menüs, Kurzinfos usw.)"

#: src/CommandLineOptions.h:40
#, kde-format
msgid "Capture a rectangular region of the screen"
msgstr "Schnappschuss eines rechteckigen Bereichs"

#: src/CommandLineOptions.h:44
#, kde-format
msgid "Launch Foton without taking a screenshot"
msgstr "Foton ohne Erstellung eines Schnappschusses starten"

#: src/CommandLineOptions.h:48
#, kde-format
msgid "Start in GUI mode (default)"
msgstr "Mit grafischer Oberfläche starten (Standard)"

#: src/CommandLineOptions.h:52
#, kde-format
msgid "Take a screenshot and exit without showing the GUI"
msgstr ""
"Einen Schnappschuss erstellen und ohne Anzeige der grafischen Oberfläche "
"beenden"

#: src/CommandLineOptions.h:56
#, kde-format
msgid ""
"Start in the background with an icon in the system tray and wait for global "
"shortcuts"
msgstr ""
"Im Hintergrund mit einem Symbol im Systemabschnitt der Kontrollleiste "
"starten und auf globale Kurzbefehle warten"

#: src/CommandLineOptions.h:60
#, kde-format
msgid ""
"In background mode, do not pop up a notification when the screenshot is taken"
msgstr ""
"Im Hintergrundmodus keine Benachrichtigung anzeigen, wenn das Bildschirmfoto "
"aufgenommen wurde"

#: src/CommandLineOptions.h:64
#, kde-format
msgid "In background mode, save image to specified file"
msgstr "Im Hintergrundmodus das Bild in die angegebene Datei speichern"

#: src/CommandLineOptions.h:69
#, kde-format
msgid "In background mode, delay before taking the shot (in milliseconds)"
msgstr "Verzögerung in Millisekunden vor der Aufnahme im Hintergrundmodus"

#: src/CommandLineOptions.h:74
#, kde-format
msgid ""
"In background mode, copy screenshot image to clipboard, unless -o is also "
"used."
msgstr ""
"Im Hintergrundmodus das Bildschirmfoto in die Zwischenablage kopieren, es "
"sei denn, -o wird verwendet."

#: src/CommandLineOptions.h:78
#, kde-format
msgid "In background mode, copy screenshot file path to clipboard"
msgstr ""
"Im Hintergrundmodus den Pfad zum Bildschirmfoto in die Zwischenablage "
"kopieren"

#: src/CommandLineOptions.h:82
#, kde-format
msgid ""
"Starts a new GUI instance of Foton instead of passing the arguments to an "
"already running instance"
msgstr ""
"Startet eine neue Instanz von Foton mit Bedienoberfläche, anstatt die "
"Argumente an eine bereits laufende Instanz zu übergeben"

#: src/CommandLineOptions.h:86
#, kde-format
msgid "In background mode, include pointer in the screenshot"
msgstr "Im Hintergrundmodus Mauszeiger im Bildschirmfoto anzeigen"

#: src/CommandLineOptions.h:90
#, kde-format
msgid "In background mode, exclude decorations in the screenshot"
msgstr "Im Hintergrundmodus Mauszeiger im Bildschirmfoto nicht anzeigen"

#: src/CommandLineOptions.h:92
#, kde-format
msgid "In background mode, exclude shadows in the screenshot"
msgstr "Im Hintergrundmodus Schatten im Bildschirmfoto weglassen"

#: src/CommandLineOptions.h:95
#, kde-format
msgid "Open and edit existing screenshot file"
msgstr "Ein existierendes Bildschirmfoto öffnen und bearbeiten"

#: src/CommandLineOptions.h:98
#, kde-format
msgid "Accept region selection on click-and-release"
msgstr "Regionsauswahl bei Klicken und Loslassen übernehmen"

